# Template for Google's MCP Toolbox (googleapis/mcp-toolbox).
# Copy to tools.yaml and fill in if you wire up the `dbtools` MCP server against this stack.
# Declares both sources centrally so one server can query either database.
# Hosts use the docker-compose service names (not localhost) because .mcp.json
# runs dbtools as a container on the stack-database-mcp_default network.

sources:
  local-postgres:
    kind: postgres
    host: postgres
    port: 5432
    database: appdb
    user: mcp_readonly
    password: readonly

  local-mysql:
    kind: mysql
    host: mysql
    port: 3306
    database: appdb
    user: mcp_readonly
    password: readonly

  local-mssql:
    kind: mssql
    host: mssql
    port: 1433
    database: appdb
    user: mcp_readonly
    password: Readonly123!

tools:
  query-customers:
    kind: postgres-sql
    source: local-postgres
    description: List customers from the seeded Postgres database.
    statement: SELECT * FROM customers;

  query-products:
    kind: mysql-sql
    source: local-mysql
    description: List products from the seeded MySQL database.
    statement: SELECT * FROM products;

  insert-customer:
    kind: postgres-sql
    source: local-postgres
    description: Attempt to insert a customer (expected to fail — read-only role).
    statement: INSERT INTO customers (name, email) VALUES ('Hacker', 'x@x.com');

  delete-product:
    kind: mysql-sql
    source: local-mysql
    description: Attempt to delete a product (expected to fail — read-only role).
    statement: DELETE FROM products WHERE id = 1;

  # --- Ad-hoc SQL execution (less safe than the fixed statements above — see README) ---

  postgres-execute-sql:
    kind: postgres-execute-sql
    source: local-postgres
    description: Execute arbitrary ad-hoc SQL against the Postgres database.

  mysql-execute-sql:
    kind: mysql-execute-sql
    source: local-mysql
    description: Execute arbitrary ad-hoc SQL against the MySQL database.

  mssql-execute-sql:
    kind: mssql-execute-sql
    source: local-mssql
    description: Execute arbitrary ad-hoc SQL against the MSSQL database.

  # --- Schema introspection ---

  postgres-list-tables:
    kind: postgres-list-tables
    source: local-postgres
    description: List tables, columns, and constraints in the Postgres database.

  postgres-list-schemas:
    kind: postgres-list-schemas
    source: local-postgres
    description: List schemas in the Postgres database.

  mysql-list-tables:
    kind: mysql-list-tables
    source: local-mysql
    description: List tables, columns, and indexes in the MySQL database.

  mssql-list-tables:
    kind: mssql-list-tables
    source: local-mssql
    description: List tables, columns, and constraints in the MSSQL database.
    # No mssql-list-schemas equivalent exists in genai-toolbox (unlike postgres) — confirmed against source.

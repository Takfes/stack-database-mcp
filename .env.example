# Copy to .env and fill in if you point real MCP servers at this stack.
# These match the credentials seeded by docker-compose.yml / init/*.sql — no real secrets here.

PG_READONLY_URI=postgresql://mcp_readonly:readonly@localhost:5432/appdb
PG_ADMIN_URI=postgresql://admin:admin@localhost:5432/appdb
MYSQL_URI=mysql://root:admin@localhost:3306/appdb

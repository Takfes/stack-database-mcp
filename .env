# Single source of credentials for this stack's MCP servers and human tooling.
# These match the credentials seeded by docker-compose.yml / init/*.sql — no real secrets here
# (disposable POC stack, throwaway passwords, seeded fresh every time).

# Host-network URIs — for a human connecting from outside Docker (psql, mysql client, etc.)
PG_READONLY_URI=postgresql://mcp_readonly:readonly@localhost:5432/appdb
PG_ADMIN_URI=postgresql://admin:admin@localhost:5432/appdb
MYSQL_URI=mysql://root:admin@localhost:3306/appdb

# Container-network URI — consumed by pgquery via `docker run --env-file .env`
# (host is the docker-compose service name, not localhost, since pgquery runs on the
# stack-database-mcp_default network alongside the postgres container).
DATABASE_URI=postgresql://mcp_readonly:readonly@postgres:5432/appdb

# Discrete per-engine credentials — consumed by dbtools via ${VAR} substitution in tools.yaml.
POSTGRES_READONLY_USER=mcp_readonly
POSTGRES_READONLY_PASSWORD=readonly
MYSQL_READONLY_USER=mcp_readonly
MYSQL_READONLY_PASSWORD=readonly
MSSQL_READONLY_USER=mcp_readonly
MSSQL_READONLY_PASSWORD=Readonly123!

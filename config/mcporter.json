{
  "mcpServers": {
    "pgquery": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--network",
        "stack-database-mcp_default",
        "-e",
        "PYTHONUNBUFFERED=1",
        "-e",
        "DATABASE_URI=postgresql://mcp_readonly:readonly@postgres:5432/appdb",
        "crystaldba/postgres-mcp",
        "--access-mode=restricted",
        "--transport=stdio"
      ]
    }
  }
}
